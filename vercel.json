{
  "cleanUrls": true,
  "redirects": [
    { "source": "/((?!aguardando).*)", "destination": "/aguardando", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
