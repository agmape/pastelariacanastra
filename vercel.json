{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/(.*)", "destination": "/aguardando.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
